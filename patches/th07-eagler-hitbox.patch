@@ -4,6 +4,21 @@
 
 #ifdef __EMSCRIPTEN__
 #include <emscripten/emscripten.h>
+#else
+#include <cstdlib>
+#include <cstring>
+#endif
+
+#ifndef __EMSCRIPTEN__
+// Native (non-web) option source: TH_HITBOX env var, values: off (default) / focus / always.
+namespace eagler_native_detail
+{
+inline const char *HitboxMode()
+{
+    static const char *mode = std::getenv("TH_HITBOX");
+    return mode ? mode : "off";
+}
+}
 #endif
 
 namespace EaglerOptions
@@ -128,7 +143,9 @@ inline bool AlwaysShowHitbox()
 #ifdef __EMSCRIPTEN__
     return EM_ASM_INT({ return !!Module.eaglerOptions?.alwaysHitbox; }) != 0;
 #else
-    return false;
+    // TH07 natively shows the hitbox while focused, so "focus" needs no override here;
+    // "always" forces it on regardless of focus state.
+    return std::strcmp(eagler_native_detail::HitboxMode(), "always") == 0;
 #endif
 }
 
