+
 void utils::Rotate(ZunVec3 *out, ZunVec3 *point, f32 angle)
 {
     f32 sinAngle;
@@ -12,3 +15,19 @@ void utils::Rotate(ZunVec3 *out, ZunVec3 *point, f32 angle)
     out->x = cosAngle * point->x + sinAngle * point->y;
     out->y = cosAngle * point->y - sinAngle * point->x;
 }
+
+void utils::DebugPrint2(const char *fmt, ...)
+{
+#ifdef DEBUG
+    char tmpBuffer[512];
+    std::va_list args;
+
+    va_start(args, fmt);
+    std::vsnprintf(tmpBuffer, 511, fmt, args);
+    va_end(args);
+
+    std::printf("DEBUG2: %s\n", tmpBuffer);
+#else
+    (void)fmt;
+#endif
+}
